# Copie para /etc/agentes/agentes.env no servidor (chmod 600, dono = usuário dos agentes).
# NUNCA versionar o arquivo preenchido. Todos os valores abaixo estão vazios de propósito.

# --- Modelo -----------------------------------------------------------------
# Sessão de longo prazo do CLI dos agentes de terminal (gerada por `claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=
# Ou, para o bot Python com a SDK:
ANTHROPIC_API_KEY=
MODELO_RASCUNHO=claude-opus-5-5
MODELO_CHECAGEM=claude-haiku-5-5

# --- Agentes no servidor ----------------------------------------------------
AGENTES="atendimento comentarios crm"
PREFIXO_SERVICO=agente
AGENTES_DIR=
CLAUDE_BIN=
PLUGIN_CANAL=plugin:discord@claude-plugins-official

# --- Bot de rascunho (ops/bot_rascunho) ------------------------------------
DISCORD_BOT_TOKEN=
CANAL_ENTRADA_ID=
CANAL_REVISAO_ID=
# IDs de usuário que podem aprovar, separados por vírgula
APROVADORES=
BASE_DIR=
PERSONA=
CAMADA_MAX=N1
TRILHA_AUDITORIA=

# --- Monitor e alertas -------------------------------------------------------
LOG_DIR=
ESTADO_DIR=
DETECTOR_FILA=1
ALERTA_EMAIL_PARA=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_APP_PASSWORD=
ALERTA_REMETENTE_NOME="Monitor dos agentes"
ALERTA_WEBHOOK_URL=
ALERTA_PREFIXO=[AGENTES]

# --- ClickUp (integracoes/clickup) ------------------------------------------
CLICKUP_TOKEN=
CLICKUP_CONFIG=

# --- Deploy (ops/deploy/sincronizar.sh, roda na máquina local) -------------
ORIGEM=
DESTINO_SSH=
CHAVE_SSH=
